#!/usr/bin/with-contenv bashio
set -euo pipefail

HOME_DIR=/data
CODEX_HOME=/data/.codex
CONFIG_FILE="${CODEX_HOME}/config.toml"
ENV_FILE=/data/.env_vars

mkdir -p "$CODEX_HOME" /data/.local/share/codex /data/.config/codex /data/.cache /data/sessions /homeassistant/.codex

toml_string() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '"%s"' "$value"
}

write_toml_string_setting() {
  local key="$1"
  local value="$2"
  printf '%s = ' "$key" >> "$CONFIG_FILE"
  toml_string "$value" >> "$CONFIG_FILE"
  printf '\n' >> "$CONFIG_FILE"
}

# Persist selected add-on metadata.
bashio::addon.version > /data/.addon_version 2>/dev/null || echo "unknown" > /data/.addon_version

# User-defined env vars; block dangerous overrides.
: > "$ENV_FILE"
if bashio::config.has_value 'env_vars'; then
  count=$(bashio::config 'env_vars | length')
  for ((i=0; i<count; i++)); do
    name=$(bashio::config "env_vars[${i}].name")
    value=$(bashio::config "env_vars[${i}].value")
    case "$name" in
      HOME|PATH|SUPERVISOR_TOKEN|HASSIO_TOKEN|CODEX_HOME|XDG_CONFIG_HOME|XDG_DATA_HOME|XDG_CACHE_HOME)
        bashio::log.warning "Ignoring protected env var: ${name}"
        ;;
      *[!A-Za-z0-9_]*|[0-9]*)
        bashio::log.warning "Ignoring invalid env var name: ${name}"
        ;;
      *)
        printf 'export %s=%q\n' "$name" "$value" >> "$ENV_FILE"
        ;;
    esac
  done
fi
chmod 600 "$ENV_FILE"

# Optional token available to tools that need direct HA Core access.
ACCESS_TOKEN=$(bashio::config 'access_token' '')
if [[ -n "$ACCESS_TOKEN" ]]; then
  printf 'export HA_ACCESS_TOKEN=%q\n' "$ACCESS_TOKEN" >> "$ENV_FILE"
fi

MCP_ENABLED=$(bashio::config 'mcp_enabled')
LSP_ENABLED=$(bashio::config 'lsp_enabled')
MODEL=$(bashio::config 'codex_model' '')
MODEL_PROVIDER=$(bashio::config 'codex_model_provider' '')
APPROVAL=$(bashio::config 'codex_approval_policy')
SANDBOX=$(bashio::config 'codex_sandbox_mode')
DEFAULT_PERMS=$(bashio::config 'codex_default_permissions')
EXTRA=$(bashio::config 'codex_config_extra' '')

cat > "$CONFIG_FILE" <<EOF2
# Generated by the Home Assistant Codex add-on. Manual changes may be overwritten on restart.
cli_auth_credentials_store = "file"
history.persistence = "save-all"
approval_policy = "${APPROVAL}"
sandbox_mode = "${SANDBOX}"
default_permissions = "${DEFAULT_PERMS}"
check_for_update_on_startup = false
model_reasoning_effort = "medium"
EOF2

if [[ -n "$MODEL" ]]; then
  write_toml_string_setting "model" "$MODEL"
fi

if [[ -n "$MODEL_PROVIDER" ]]; then
  write_toml_string_setting "model_provider" "$MODEL_PROVIDER"
fi

if bashio::config.has_value 'custom_model_providers'; then
  count=$(bashio::config 'custom_model_providers | length')
  for ((i=0; i<count; i++)); do
    provider=$(bashio::config "custom_model_providers[${i}].provider")
    name=$(bashio::config "custom_model_providers[${i}].name")
    base_url=$(bashio::config "custom_model_providers[${i}].base_url")
    wire_api=$(bashio::config "custom_model_providers[${i}].wire_api")
    env_key=$(bashio::config "custom_model_providers[${i}].env_key")
    supports_websockets=$(bashio::config "custom_model_providers[${i}].supports_websockets")
    requires_openai_auth=$(bashio::config "custom_model_providers[${i}].requires_openai_auth")

    if [[ ! "$provider" =~ ^[A-Za-z0-9_-]+$ ]]; then
      bashio::log.warning "Ignoring custom model provider with invalid name: ${provider}"
      continue
    fi

    printf '\n[model_providers.%s]\n' "$provider" >> "$CONFIG_FILE"
    write_toml_string_setting "name" "$name"
    write_toml_string_setting "base_url" "$base_url"
    write_toml_string_setting "wire_api" "$wire_api"
    write_toml_string_setting "env_key" "$env_key"
    printf 'supports_websockets = %s\n' "$supports_websockets" >> "$CONFIG_FILE"
    printf 'requires_openai_auth = %s\n' "$requires_openai_auth" >> "$CONFIG_FILE"
  done
fi

cat >> "$CONFIG_FILE" <<'EOF2'

[projects."/homeassistant"]
trust_level = "trusted"
EOF2

if [[ "$MCP_ENABLED" == "true" ]]; then
cat >> "$CONFIG_FILE" <<'EOF2'

[mcp_servers.homeassistant]
enabled = true
command = "node"
args = ["/opt/ha-mcp-server/index.js"]
cwd = "/homeassistant"
startup_timeout_sec = 15
tool_timeout_sec = 90
env_vars = ["SUPERVISOR_TOKEN", "HA_ACCESS_TOKEN"]
EOF2
fi

if [[ -n "$EXTRA" ]]; then
  printf '\n# User-supplied codex_config_extra\n%s\n' "$EXTRA" >> "$CONFIG_FILE"
fi

# Project-level hints for Codex.
cat > /homeassistant/AGENTS.md <<'EOF2'
# Home Assistant Codex Agent Instructions

You are operating inside a Home Assistant add-on with `/homeassistant` mounted read/write.

Safety rules:
- Before changing important YAML, inspect the current file and preserve existing keys/includes.
- Prefer editing package files, automations, scripts, scenes, dashboards, and helpers in small diffs.
- Validate YAML with `python3 -m yaml` when possible and use `ha-validate` for Home Assistant checks.
- For logs, use `ha-logs core`, `ha-logs error`, `ha-logs supervisor`, or `ha-logs host`.
- For Home Assistant API operations, prefer `hab` or the Home Assistant MCP tools.
- Do not edit `.storage` files unless the user explicitly asks and you create a backup first.
EOF2

# SSH setup, if enabled.
if bashio::config.true 'ssh_enabled'; then
  if ! id codex >/dev/null 2>&1; then
    useradd -m -d /data -s /bin/bash codex
  fi
  mkdir -p /data/.ssh /run/sshd
  chown -R codex:codex /data/.ssh
  chmod 700 /data/.ssh
  PUBKEY=$(bashio::config 'ssh_public_key' '')
  PASSWORD=$(bashio::config 'ssh_password' '')
  if [[ -n "$PUBKEY" ]]; then
    echo "$PUBKEY" > /data/.ssh/authorized_keys
    chown codex:codex /data/.ssh/authorized_keys
    chmod 600 /data/.ssh/authorized_keys
  fi
  if [[ -n "$PASSWORD" ]]; then
    echo "codex:${PASSWORD}" | chpasswd
  else
    passwd -l codex >/dev/null 2>&1 || true
  fi
  echo 'codex ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/codex
  chmod 0440 /etc/sudoers.d/codex
  ssh-keygen -A
  cat > /etc/ssh/sshd_config <<EOF2
Port 2222
ListenAddress 0.0.0.0
PermitRootLogin no
PasswordAuthentication $([[ -n "$PASSWORD" ]] && echo yes || echo no)
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
AllowUsers codex
X11Forwarding no
AllowTcpForwarding no
GatewayPorts no
PermitTunnel no
ClientAliveInterval 30
ClientAliveCountMax 3
Subsystem sftp internal-sftp
EOF2
fi

bashio::log.info "Codex initialization complete"
